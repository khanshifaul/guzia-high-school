# --- API app (apps/api) ---
# Copy to .env.local for dev. Every used var appears here.

[REQUIRED] DATABASE_URL=postgresql://ghs:ghs_dev_password@localhost:5434/ghs
[REQUIRED] JWT_SECRET=change-me-to-a-long-random-string
[REQUIRED] AI_CONFIG_SECRET=change-me-32-byte-aes-key-xxxxxxx
[REQUIRED] PORT=4000

# Boot-seed defaults for the admin-configurable AI provider row (spec 10).
# Runtime truth lives in the DB (AiProviderConfig); these only seed the first run.
[OPTIONAL] AI_PROVIDER=mock
[OPTIONAL] AI_MOCK=true
[OPTIONAL] DEEPSEEK_API_KEY=
[OPTIONAL] DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
[OPTIONAL] DEEPSEEK_MODEL=deepseek-chat
[OPTIONAL] GEMINI_API_KEY=

# Kilo gateway fallback (real-life LLM when no DB AiProviderConfig row exists).
# Fallback order: DB row (admin-configured, encrypted key) → KILO_* env → mock → 503.
# Set KILO_API_TOKEN in .env.local (never commit it).
[OPTIONAL] KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway
[OPTIONAL] KILO_MODEL=kilo-auto/free
[OPTIONAL] KILO_VISION_MODEL=            # e.g. nvidia/nemotron-3.5-super-vl:free (image → text)
[OPTIONAL] KILO_API_TOKEN=

# Resend (transactional email for admission credentials). Leave blank to skip
# sending — credentials are still shown on-screen after an application.
[OPTIONAL] RESEND_API_KEY=
[OPTIONAL] RESEND_FROM=Guzia High School <onboarding@resend.dev>

# Object storage (S3-compatible) for file/image uploads. Works with Backblaze
# B2, Cloudflare R2, MinIO, etc. Leave blank to fall back to local-disk storage
# under uploads/ (works offline for the demo).
[OPTIONAL] STORAGE_ENDPOINT=              # e.g. https://s3.eu-central-003.backblazeb2.com
[OPTIONAL] STORAGE_REGION=                # e.g. eu-central-003 (R2: auto)
[OPTIONAL] STORAGE_BUCKET=guzia-uploads
[OPTIONAL] STORAGE_ACCESS_KEY_ID=         # B2: application key ID
[OPTIONAL] STORAGE_SECRET_ACCESS_KEY=     # B2: application key
[OPTIONAL] STORAGE_PUBLIC_URL=            # optional public/CDN base URL
[OPTIONAL] STORAGE_FORCE_PATH_STYLE=false # true for Backblaze B2

# Max upload size for file sources (MB). Files are buffered in memory, so keep
# this modest; very large PDFs need a presigned direct-to-storage flow.
[OPTIONAL] MAX_UPLOAD_MB=50

# Legacy Cloudflare R2 vars (still honored when the STORAGE_* vars are unset).
[OPTIONAL] CF_ACCOUNT_ID=
[OPTIONAL] CF_R2_ACCESS_KEY_ID=
[OPTIONAL] CF_R2_SECRET_ACCESS_KEY=
[OPTIONAL] CF_R2_BUCKET_NAME=guzia-uploads
[OPTIONAL] CF_R2_PUBLIC_URL=

# Web app reads these (see apps/web/.env.example)
