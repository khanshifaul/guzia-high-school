# --- Web app (apps/web) ---
# Copy to .env.local for dev.

[REQUIRED] API_BASE_URL
API_BASE_URL=http://localhost:4000

# Browser-side API origin for direct file uploads (bypasses the dev proxy body
# limit). Leave empty when web + api are served same-origin behind a proxy.
[OPTIONAL] NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=http://localhost:4000
